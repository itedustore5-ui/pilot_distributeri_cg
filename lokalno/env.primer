# Kopiraj u lokalno/.env i popuni. Ovaj fajl ostaje kod klijenta.

# Lozinka baze — nasumična, bar 20 znakova, samo slova i brojevi
LOZINKA_BAZE=promeni-me-obavezno

# Pristupni token za izveštaje. Generisanje:
#   docker run --rm node:22-alpine node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=promeni-me-obavezno-najmanje-32-znaka

# Na kom portu servera radi aplikacija
PORT_NA_SERVERU=3000
