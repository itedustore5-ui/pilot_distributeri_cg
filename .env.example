# =====================================================================
#  PRIMJER PODEŠAVANJA
#
#  Prekopiraj ovaj fajl u .env i popuni. .env NIKAD ne ide u git —
#  u njemu su pristupni podaci baze i glavni ključ.
#
#  Jedan klijent = jedna baza = jedan servis na Renderu.
#  Ovaj fajl se popunjava iznova za svakog klijenta.
# =====================================================================

# ---------------------------------------------------------------------
#  BAZA — Supabase
#
#  Uzima se sa: Supabase -> tvoj projekat -> Connect -> Session pooler.
#
#  MORA biti Session pooler i port 5432.
#  · Direct connection (port 5432, ali druga adresa) radi samo preko IPv6
#    i Render ga NE dohvata.
#  · Transaction pooler (port 6543) ne podržava sve što aplikacija radi.
#
#  Lozinku upisuješ ti — u adresi koju Supabase pokaže stoji [YOUR-PASSWORD].
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.xxxxxxxx:LOZINKA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------
#  GLAVNI KLJUČ
#
#  Otvara sve, bez prijave, kroz zaglavlje x-admin-token. Koristi se za
#  alate i za ispomoć kad se klijent zaključa. Neka bude dugačak i
#  nasumičan — najmanje 32 znaka.
#
#  Napravi ga ovako, pa prekopiraj ispis:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
#  Različit za svakog klijenta. Ako procuri, promijeni ga i ovdje i na Renderu.
# ---------------------------------------------------------------------
ADMIN_TOKEN=

# ---------------------------------------------------------------------
#  PORT — samo za rad na tvom računaru.
#  Render dodjeljuje svoj port sam; tamo se ovo NE unosi.
# ---------------------------------------------------------------------
PORT=3000

# ---------------------------------------------------------------------
#  MEJL — neobavezno. Koristi ga samo alati/dnevni-pregled.mjs, i to
#  samo kad neki klijent uđe u zastoj. Ako ovo ostane prazno, alat radi
#  normalno, samo ne šalje ništa.
#
#  Gmail: Bezbjednost -> Potvrda u dva koraka -> Lozinke za aplikacije.
#  Lozinka za aplikaciju je 16 znakova i NIJE tvoja lozinka za Gmail.
#
#  Ovo NE ide na Render — dnevni pregled radi sa tvog računara.
# ---------------------------------------------------------------------
MEJL_OD=
MEJL_LOZINKA=
MEJL_ZA=
